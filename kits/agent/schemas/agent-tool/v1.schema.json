{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutsuki.agent-tool.v1",
  "type": "object",
  "required": ["name", "target_protocol_id", "description"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "target_protocol_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "input_schema": true,
    "output_schema": true,
    "side_effect": {
      "enum": ["none", "workspace_read", "workspace_write", "external_read", "external_write"]
    },
    "requires_approval": { "type": "boolean" },
    "target_payload_mode": { "enum": ["raw_input", "execution_request"], "default": "raw_input" },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "routed" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "interaction_kind"],
          "properties": {
            "kind": { "const": "interaction" },
            "interaction_kind": {
              "enum": ["approval", "clarification", "plan_confirm", "custom"]
            }
          },
          "additionalProperties": false
        }
      ],
      "default": { "kind": "routed" }
    },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "call_id": { "type": ["string", "null"] },
    "input": true,
    "output": true,
    "output_ref": { "type": ["string", "null"] },
    "approved": { "type": "boolean" }
  }
}
