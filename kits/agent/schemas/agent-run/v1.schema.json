{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutsuki.agent-run.v1",
  "type": "object",
  "required": ["profile_id", "messages"],
  "properties": {
    "profile_id": { "type": "string", "minLength": 1 },
    "messages": { "type": "array", "items": { "$ref": "../agent-message/v1.schema.json" } },
    "session_id": { "type": ["string", "null"] },
    "turn_id": { "type": ["string", "null"] },
    "max_steps": { "type": "integer", "minimum": 0, "default": 8 },
    "budget": {
      "type": "object",
      "properties": {
        "max_context_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "max_total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "max_cost_microunits": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "stream": { "type": "boolean", "default": false },
    "permission_mode": { "enum": ["ask", "full", "read_only"], "default": "ask" },
    "model": { "type": ["string", "null"] },
    "provider_hint": { "type": ["string", "null"] },
    "metadata": true,
    "result_protocol_id": { "type": ["string", "null"] },
    "result_context": true,
    "permission_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_id", "turn_id", "action_id", "version", "decision"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "turn_id": { "type": "string", "minLength": 1 },
          "action_id": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 0 },
          "decision": { "enum": ["approved", "rejected", "timed_out", "cancelled"] }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "interaction_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_id", "turn_id", "version", "interaction_id", "accepted", "response"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "turn_id": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 0 },
          "interaction_id": { "type": "string", "minLength": 1 },
          "accepted": { "type": "boolean" },
          "response": true
        },
        "additionalProperties": false
      },
      "default": []
    },
    "cost_microunits": { "type": "integer", "minimum": 0 },
    "output_resource": { "type": ["object", "null"] }
  }
}
