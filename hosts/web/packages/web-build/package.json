  "dependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "es-module-lexer": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
