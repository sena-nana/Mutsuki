{
  "name": "@mutsuki/web-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mutsuki-web-build": "./bin/mutsuki-web-build.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
