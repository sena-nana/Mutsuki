{
  "name": "@mutsuki/web-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && pnpm build:browser",
    "build:browser": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --alias:@msgpack/msgpack=./node_modules/@msgpack/msgpack/dist.esm/index.mjs --outfile=browser/web-sdk.js",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "pinia": "^2.2.0",
    "typescript": "^5.6.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  }
}
