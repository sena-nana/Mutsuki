{
  "name": "@mutsuki/web-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && pnpm build:browser",
    "build:browser": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --alias:@msgpack/msgpack=./node_modules/@msgpack/msgpack/dist.esm/index.mjs --outfile=browser/web-sdk.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@msgpack/msgpack": "catalog:"
  },
  "peerDependencies": {
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "pinia": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
