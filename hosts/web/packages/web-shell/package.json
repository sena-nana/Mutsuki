{
  "name": "@mutsuki/web-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && pnpm build:browser",
    "build:browser": "esbuild src/runtime.ts --bundle --format=esm --platform=browser --target=es2022 --alias:@mutsuki/web-sdk=./web-sdk.js --external:./web-sdk.js --alias:@mutsuki/ui=../ui/dist/theme.js --outfile=browser/web-shell.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mutsuki/ui": "workspace:*",
    "@mutsuki/web-sdk": "workspace:*"
  },
  "peerDependencies": {
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "pinia": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
