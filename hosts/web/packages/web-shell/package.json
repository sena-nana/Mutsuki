{
  "name": "@mutsuki/web-shell",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && pnpm build:browser",
    "build:browser": "esbuild src/runtime.ts --bundle --format=esm --platform=browser --target=es2022 --external:@mutsuki/web-sdk --outfile=browser/web-shell.js"
  },
  "dependencies": {
    "@mutsuki/ui": "workspace:*",
    "@mutsuki/web-sdk": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.0"
  }
}
