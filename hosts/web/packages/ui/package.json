{
  "name": "@mutsuki/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui.css": "./dist/mutsuki-ui.css",
    "./styles.css": "./src/styles/index.css",
    "./styles/console.css": "./src/styles/console.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node ./scripts/bundle-css.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@lilia/theme": "github:sena-nana/LiliaUI#804c427ed72e424753d1cc220fcbe2313c8e20fb&path:/packages/theme",
    "@mutsuki/web-sdk": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "axe-core": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
